procedure TfrmBoasVindas.FormDestroy(Sender: TObject);
begin
  tmrAnimar.Enabled := False;
  tmrPulsar.Enabled := False;
end;

procedure TfrmBoasVindas.FormPaint(Sender: TObject);
begin
  DesenharFundo(Self.Canvas);
end;

procedure TfrmBoasVindas.DesenharFundo(ACanvas: TCanvas);
var
  i: Integer;
  LBrush: TBrush;
  X, W: Integer;
begin
  // Fundo base escuro
  ACanvas.Brush.Color := $00100808;
  ACanvas.FillRect(Self.ClientRect);

  // Desenhar filmstrip no topo
  ACanvas.Brush.Color := $000D0D14;
  ACanvas.FillRect(Rect(0, 0, Self.ClientWidth, 50));

  // Furos da filmstrip
  ACanvas.Brush.Color := $00100808;
  ACanvas.Pen.Color := $00202028;
  ACanvas.Pen.Width := 1;
  X := 10;
  while X < Self.ClientWidth do
  begin
    ACanvas.RoundRect(X, 11, X + 26, 39, 4, 4);
    Inc(X, 46);
  end;

  // Filmstrip inferior
  ACanvas.Brush.Color := $000D0D14;
  ACanvas.FillRect(Rect(0, Self.ClientHeight - 50, Self.ClientWidth, Self.ClientHeight));

  ACanvas.Brush.Color := $00100808;
  X := 10;
  while X < Self.ClientWidth do
  begin
    ACanvas.RoundRect(X, Self.ClientHeight - 39, X + 26, Self.ClientHeight - 11, 4, 4);
    Inc(X, 46);
  end;

  // Linha de brilho topo
  ACanvas.Pen.Color := $002035D0;
  ACanvas.Pen.Width := 1;
  ACanvas.MoveTo(0, 50);
  ACanvas.LineTo(Self.ClientWidth, 50);

  // Linha de brilho base
  ACanvas.MoveTo(0, Self.ClientHeight - 50);
  ACanvas.LineTo(Self.ClientWidth, Self.ClientHeight - 50);

  // Borda do card central
  ACanvas.Brush.Style := bsClear;
  ACanvas.Pen.Color := $00282828;
  ACanvas.Pen.Width := 1;
  ACanvas.Rectangle(
    pnlCentro.Left, pnlCentro.Top,
    pnlCentro.Left + pnlCentro.Width,
    pnlCentro.Top + pnlCentro.Height
  );

  // Borda esquerda vermelha do card
  ACanvas.Pen.Color := $002035D0;
  ACanvas.Pen.Width := 3;
  ACanvas.MoveTo(pnlCentro.Left, pnlCentro.Top);
  ACanvas.LineTo(pnlCentro.Left, pnlCentro.Top + pnlCentro.Height);
end;

procedure TfrmBoasVindas.tmrAnimarTimer(Sender: TObject);
begin
  // Reposicionar lblTrack dinamicamente (após AutoSize do lblCine)
  if lblCine.Width > 10 then
    lblTrack.Left := lblCine.Left + lblCine.Width;

  // Fade-in suave do painel central
  if FAlpha < 255 then
  begin
    Inc(FAlpha, 8);
    if FAlpha > 255 then FAlpha := 255;

    pnlCentro.Left := (Self.ClientWidth - pnlCentro.Width) div 2;
    pnlCentro.Top  := (Self.ClientHeight - pnlCentro.Height) div 2;
  end;

  Invalidate;
end;

procedure TfrmBoasVindas.tmrPulsarTimer(Sender: TObject);
begin
  // Efeito pulsar no botão (cor oscilante sutil)
  if FPulsarUp then
  begin
    Inc(FPulsarAlpha, 5);
    if FPulsarAlpha >= 220 then FPulsarUp := False;
  end
  else
  begin
    Dec(FPulsarAlpha, 5);
    if FPulsarAlpha <= 160 then FPulsarUp := True;
  end;
end;

procedure TfrmBoasVindas.btnAcessarMouseEnter(Sender: TObject);
begin
  btnAcessar.Font.Color := clWhite;
end;

procedure TfrmBoasVindas.btnAcessarMouseLeave(Sender: TObject);
begin
  btnAcessar.Font.Color := clWhite;
end;


procedure TfrmBoasVindas.btnFecharClick(Sender: TObject);
begin
  Application.Terminate;
end;

procedure TfrmBoasVindas.btnAcessarClick(Sender: TObject);
begin
  AbrirCadastro;
end;

procedure TfrmBoasVindas.AbrirCadastro;
begin
  tmrAnimar.Enabled := False;
  tmrPulsar.Enabled := False;

  if not Assigned(frmPagPrincipal) then
    frmPagPrincipal := TfrmPagPrincipal.Create(Application);

  frmPagPrincipal.Show;
  Self.Hide;
end;

procedure TfrmBoasVindas.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := caFree;
  frmBoasVindas := nil;
end;

end.
