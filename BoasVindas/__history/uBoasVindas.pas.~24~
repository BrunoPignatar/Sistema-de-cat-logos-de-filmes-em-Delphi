    pnlBotao: TPanel;
    lblCine: TLabel;
    lblTrack: TLabel;
    lblSubtitulo: TLabel;
    lblDescricao: TLabel;
    lblVersao: TLabel;
    lblIconeFilme: TLabel;
    btnAcessar: TButton;
    shpLinhaEsq: TShape;
    shpLinhaDireita: TShape;
    tmrAnimar: TTimer;
    tmrPulsar: TTimer;
    btnFechar: TButton;
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure btnAcessarClick(Sender: TObject);
    procedure FormPaint(Sender: TObject);
    procedure tmrAnimarTimer(Sender: TObject);
    procedure tmrPulsarTimer(Sender: TObject);
    procedure btnAcessarMouseEnter(Sender: TObject);
    procedure btnAcessarMouseLeave(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure btnFecharClick(Sender: TObject);
  private
    FAlpha: Byte;
    FPulsarUp: Boolean;
    FPulsarAlpha: Integer;
    procedure DesenharFundo(ACanvas: TCanvas);
    procedure AbrirCadastro;
  public
    { Public declarations }
  end;

var
  frmBoasVindas: TfrmBoasVindas;

implementation

{$R *.dfm}

uses
  uCadFilme, uDtmConexao, uPagPrincipal;

