{ =========================================================================== }
{ Helpers de cor                                                               }
{ =========================================================================== }

function MisturarCor(C1, C2: TColor; Fator: Double): TColor;
var
  R1, G1, B1, R2, G2, B2: Byte;
begin
  R1 := C1 and $FF;         G1 := (C1 shr 8) and $FF;  B1 := (C1 shr 16) and $FF;
  R2 := C2 and $FF;         G2 := (C2 shr 8) and $FF;  B2 := (C2 shr 16) and $FF;
  Result := RGB(
    Round(R1 + (R2 - R1) * Fator),
    Round(G1 + (G2 - G1) * Fator),
    Round(B1 + (B2 - B1) * Fator)
  );
end;

procedure PreencherVertical(ACanvas: TCanvas; ARect: TRect;
  CTop, CBot: TColor; Passos: Integer);
var
  I, H: Integer;
begin
  H := ARect.Bottom - ARect.Top;
  if H <= 0 then Exit;
  for I := 0 to Passos - 1 do
  begin
    ACanvas.Brush.Color := MisturarCor(CTop, CBot, I / (Passos - 1));
    ACanvas.FillRect(Rect(
      ARect.Left,
      ARect.Top + (I * H) div Passos,
      ARect.Right,
      ARect.Top + ((I + 1) * H) div Passos + 1
    ));
  end;
end;

