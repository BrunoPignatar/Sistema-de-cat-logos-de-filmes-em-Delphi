{ =========================================================================== }
{ DesenharCardCinema  - toda a arte visual do pnlCentro                       }
{ =========================================================================== }

procedure TfrmBoasVindas.DesenharCardCinema(ACanvas: TCanvas; APanel: TPanel);
var
  W, H, I, StX: Integer;
  ClapX, ClapY, ClapW, ClapH: Integer;
  LightX, LightY, LightR: Integer;
  BX, BY, BW, BbH: Integer;
begin
  W := APanel.ClientWidth;
  H := APanel.ClientHeight;

  // 1. Fundo com degradê vertical suave
  PreencherVertical(ACanvas, Rect(0, 0, W, H), $00180C0C, $000A0606, 48);

  // 2. Faixa lateral direita (tom diferente para separar as duas zonas)
  PreencherVertical(ACanvas, Rect(W - 250, 0, W, H), $001C1010, $000E0808, 48);

  // 3. Tira de filme superior
  ACanvas.Brush.Color := $000A0606;
  ACanvas.FillRect(Rect(0, 0, W, 28));
  ACanvas.Brush.Color := $00120808;
  ACanvas.Pen.Color   := $001C1010;
  ACanvas.Pen.Width   := 1;
  StX := 8;
  while StX < W do
  begin
    ACanvas.RoundRect(StX, 5, StX + 22, 23, 3, 3);
    Inc(StX, 38);
  end;
  ACanvas.Pen.Color := $002035D0;
  ACanvas.Pen.Width := 2;
  ACanvas.MoveTo(0, 28);
  ACanvas.LineTo(W, 28);

  // 4. Tira de filme inferior
  ACanvas.Brush.Color := $000A0606;
  ACanvas.FillRect(Rect(0, H - 28, W, H));
  ACanvas.Brush.Color := $00120808;
  ACanvas.Pen.Color   := $001C1010;
  ACanvas.Pen.Width   := 1;
  StX := 8;
  while StX < W do
  begin
    ACanvas.RoundRect(StX, H - 23, StX + 22, H - 5, 3, 3);
    Inc(StX, 38);
  end;
  ACanvas.Pen.Color := $002035D0;
  ACanvas.Pen.Width := 2;
  ACanvas.MoveTo(0, H - 28);
  ACanvas.LineTo(W, H - 28);

  // 5. Claquete estilizada (lado direito)
  ClapX := W - 228;
  ClapY := 48;
  ClapW := 176;
  ClapH := 136;

  // Sombra/halos da claquete
  ACanvas.Brush.Style := bsClear;
  ACanvas.Pen.Color   := $00180A0A;
  ACanvas.Pen.Width   := 6;
  ACanvas.Rectangle(ClapX - 4, ClapY - 4, ClapX + ClapW + 4, ClapY + ClapH + 4);

  // Corpo da claquete
  ACanvas.Brush.Color := $001E1212;
  ACanvas.Brush.Style := bsSolid;
  ACanvas.Pen.Color   := $00301818;
  ACanvas.Pen.Width   := 1;
  ACanvas.Rectangle(ClapX, ClapY + 30, ClapX + ClapW, ClapY + ClapH);

  // Listras diagonais decorativas no corpo
  ACanvas.Pen.Color := $00280E0E;
  ACanvas.Pen.Width := 1;
  for I := -2 to 14 do
  begin
    ACanvas.MoveTo(ClapX + I * 18,       ClapY + 30);
    ACanvas.LineTo(ClapX + I * 18 + 36,  ClapY + ClapH);
  end;

  // Painel interno (dados de marcacao)
  ACanvas.Brush.Color := $00160C0C;
  ACanvas.Brush.Style := bsSolid;
  ACanvas.Pen.Color   := $00281414;
  ACanvas.Pen.Width   := 1;
  ACanvas.Rectangle(ClapX + 10, ClapY + 38, ClapX + ClapW - 10, ClapY + ClapH - 8);

  // Textos no painel interno
  ACanvas.Brush.Style := bsClear;
  ACanvas.Font.Name   := 'Courier New';
  ACanvas.Font.Size   := 7;
  ACanvas.Font.Style  := [];
  ACanvas.Font.Color  := $00383838;
  ACanvas.TextOut(ClapX + 16, ClapY + 42, 'PROD  CineTrack');
  ACanvas.TextOut(ClapX + 16, ClapY + 56, 'DIR   Sistema');
  ACanvas.TextOut(ClapX + 16, ClapY + 70, 'CENA  001  TAKE 1');
  ACanvas.Font.Color := $00303030;
  ACanvas.TextOut(ClapX + 16, ClapY + 86, 'DATA  ' + FormatDateTime('DD/MM/YY', Now));

  // Tampa da claquete com listras P&B
  ACanvas.Brush.Style := bsSolid;
  for I := 0 to 13 do
  begin
    if Odd(I) then
      ACanvas.Brush.Color := $00141414
    else
      ACanvas.Brush.Color := $00DADADA;
    ACanvas.Pen.Color   := ACanvas.Brush.Color;
    ACanvas.Pen.Width   := 1;
    ACanvas.Polygon([
      Point(ClapX + I * 14,           ClapY),
      Point(ClapX + I * 14 + 14,      ClapY),
      Point(ClapX + I * 14 + 14 - 28, ClapY + 28),
      Point(ClapX + I * 14 - 28,      ClapY + 28)
    ]);
  end;
  // Borda da tampa
  ACanvas.Brush.Style := bsClear;
  ACanvas.Pen.Color   := $00281414;
  ACanvas.Pen.Width   := 2;
  ACanvas.Rectangle(ClapX, ClapY, ClapX + ClapW, ClapY + 30);

  // Pinos (charneiras) vermelho-azulado
  ACanvas.Brush.Color := $002035D0;
  ACanvas.Brush.Style := bsSolid;
  ACanvas.Pen.Color   := $003855E0;
  ACanvas.Pen.Width   := 1;
  ACanvas.Ellipse(ClapX + 5,           ClapY - 7, ClapX + 17,           ClapY + 7);
  ACanvas.Ellipse(ClapX + ClapW - 17,  ClapY - 7, ClapX + ClapW - 5,    ClapY + 7);

  // 6. Projetor de luz (canto superior direito)
  LightX := W - 28;
  LightY := 52;
  LightR := 18;

  // Raios de luz (linhas finas em leque)
  ACanvas.Pen.Width := 1;
  for I := 0 to 9 do
  begin
    ACanvas.Pen.Color := MisturarCor($001830A0, $000A0606, 0.05 + I * 0.04);
    ACanvas.MoveTo(LightX, LightY);
    ACanvas.LineTo(
      LightX - Round(Cos(I * Pi / 8) * 100),
      LightY + Round(Sin(I * Pi / 8) * 100)
    );
  end;

  // Corpo do projetor
  ACanvas.Brush.Color := $00201616;
  ACanvas.Brush.Style := bsSolid;
  ACanvas.Pen.Color   := $002840C0;
  ACanvas.Pen.Width   := 2;
  ACanvas.Ellipse(LightX - LightR, LightY - LightR, LightX + LightR, LightY + LightR);

  // Lente interna
  ACanvas.Brush.Color := $001A2890;
  ACanvas.Pen.Color   := $003050D8;
  ACanvas.Pen.Width   := 1;
  ACanvas.Ellipse(LightX - 8, LightY - 8, LightX + 8, LightY + 8);

  // Reflexo brilhante
  ACanvas.Brush.Color := $004060E0;
  ACanvas.Pen.Color   := $004060E0;
  ACanvas.Ellipse(LightX - 3, LightY - 5, LightX + 1, LightY - 1);

  // 7. Pontos de luz decorativos (estrelas)
  ACanvas.Brush.Style := bsSolid;
  // ponto vermelho brilhante
  ACanvas.Pen.Color   := $002035D0;
  ACanvas.Brush.Color := $002035D0;
  ACanvas.Ellipse(W - 58, 198, W - 52, 204);
  // pontos menores/apagados
  ACanvas.Pen.Color   := $00202868;
  ACanvas.Brush.Color := $00202868;
  ACanvas.Ellipse(W - 80, 240, W - 76, 244);
  ACanvas.Pen.Color   := $00181840;
  ACanvas.Brush.Color := $00181840;
  ACanvas.Ellipse(W - 44, 265, W - 41, 268);
  ACanvas.Pen.Color   := $002030A0;
  ACanvas.Brush.Color := $002030A0;
  ACanvas.Ellipse(W - 98, 178, W - 94, 182);
  ACanvas.Pen.Color   := $00181838;
  ACanvas.Brush.Color := $00181838;
  ACanvas.Ellipse(W - 68, 310, W - 65, 313);

  // 8. Badge "CINEMA"
  BX := 48;  BY := 312;  BW := 74;  BbH := 20;
  ACanvas.Brush.Color := $00180C0C;
  ACanvas.Brush.Style := bsSolid;
  ACanvas.Pen.Color   := $002035D0;
  ACanvas.Pen.Width   := 1;
  ACanvas.RoundRect(BX, BY, BX + BW, BY + BbH, 6, 6);
  ACanvas.Font.Name   := 'Segoe UI';
  ACanvas.Font.Size   := 7;
  ACanvas.Font.Style  := [];
  ACanvas.Font.Color  := $002845B8;
  ACanvas.Brush.Style := bsClear;
  ACanvas.TextOut(BX + 10, BY + 4, 'CINEMA');

  // 9. Moldura interna decorativa do card (cantos duplos)
  ACanvas.Brush.Style := bsClear;
  ACanvas.Pen.Color   := $001E1010;
  ACanvas.Pen.Width   := 1;
  ACanvas.Rectangle(8, 34, W - 8, H - 34);

  // Canto vermelho superior esquerdo
  ACanvas.Pen.Color := $002035D0;
  ACanvas.Pen.Width := 2;
  ACanvas.MoveTo(8, 34);
  ACanvas.LineTo(50, 34);
  ACanvas.MoveTo(8, 34);
  ACanvas.LineTo(8, 82);

  // Canto vermelho inferior direito
  ACanvas.MoveTo(W - 8, H - 34);
  ACanvas.LineTo(W - 50, H - 34);
  ACanvas.MoveTo(W - 8, H - 34);
  ACanvas.LineTo(W - 8, H - 82);

  // Linha divisoria vertical separando texto (esq) da arte (dir)
  ACanvas.Pen.Color := $001C1010;
  ACanvas.Pen.Width := 1;
  ACanvas.MoveTo(W - 252, 34);
  ACanvas.LineTo(W - 252, H - 34);

  // Ponto vermelho decorativo na divisoria
  ACanvas.Brush.Color := $002035D0;
  ACanvas.Brush.Style := bsSolid;
  ACanvas.Pen.Color   := $002035D0;
  ACanvas.Ellipse(W - 255, (H div 2) - 3, W - 249, (H div 2) + 3);
end;

