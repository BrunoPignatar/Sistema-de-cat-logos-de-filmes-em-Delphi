procedure TfrmBoasVindas.AbrirCadastro;
begin
  tmrAnimar.Enabled := False;
  tmrPulsar.Enabled := False;

  if not Assigned(frmCadFilme) then
    frmCadFilme := TfrmCadFilme.Create(Application);

  frmCadFilme.Show;
  Self.Hide;
end;

