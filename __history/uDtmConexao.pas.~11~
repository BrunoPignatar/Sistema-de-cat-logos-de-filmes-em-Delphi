unit uDtmConexao;

interface

uses
  System.SysUtils, System.Classes, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys, FireDAC.Phys.MSSQL,
  FireDAC.Phys.MSSQLDef, FireDAC.VCLUI.Wait, Data.DB, FireDAC.Comp.Client;

type
  TDataModule1 = class(TDataModule)
    ConexaoDB: TFDConnection;
    procedure DataModuleCreate(Sender: TObject);
  private

    { Private declarations }
  public
    { Public declarations }
    procedure CriarTabela;
  end;

var
  DataModule1: TDataModule1;

implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}


uses System.IniFiles, System.IOUtils;


{$R *.dfm}

procedure TDataModule1.DataModuleCreate(Sender: TObject);
var
  Ini: TIniFile;
  Path, Auth: string;
begin
  Path := TPath.Combine(ExtractFilePath(ParamStr(0)), 'config.ini');

  if not FileExists(Path) then
    raise Exception.Create('Arquivo config.ini não encontrado.');

  Ini := TIniFile.Create(Path);
  try
    ConexaoDB.Params.DriverID := 'MSSQL';

    ConexaoDB.Params.Values['Server'] := Ini.ReadString('DB','Server','');
    ConexaoDB.Params.Values['Database'] := Ini.ReadString('DB','Database','');

    Auth := Ini.ReadString('DB','Auth','SQL');

    if SameText(Auth, 'Windows') then
    begin
      ConexaoDB.Params.Values['OSAuthent'] := 'Yes';
    end
    else
    begin
      ConexaoDB.Params.Values['User_Name'] := Ini.ReadString('DB','User','');
      ConexaoDB.Params.Values['Password'] := Ini.ReadString('DB','Password','');
    end;

    ConexaoDB.LoginPrompt := False;
    ConexaoDB.Connected := True;

  finally
    Ini.Free;
  end;
end;


procedure TDataModule1.CriarTabela;
begin
  ConexaoDB.Connected := True;

  ConexaoDB.ExecSQL(
    'IF NOT EXISTS (SELECT * FROM sys.tables WHERE name = ''catalogo'') ' +
    'BEGIN ' +
   ' create table catalogo(      '      +
	 ' idFilme int identity,       '      +
   ' titulo varchar(100),        '      +
	 ' diretor varchar(100),       '      +
	 ' genero varchar(50),         '      +
   ' sinopse varchar(500),       '      +
	 ' anoLancamento varchar(10)   '      +
	 ' constraint pk_filme primary key (titulo, diretor) )'+
  );
end;

end.
