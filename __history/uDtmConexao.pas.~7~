unit uDtmConexao;

interface

uses
  System.SysUtils, System.Classes, FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async, FireDAC.Phys, FireDAC.Phys.MSSQL,
  FireDAC.Phys.MSSQLDef, FireDAC.VCLUI.Wait, Data.DB, FireDAC.Comp.Client;

type
  TDataModule1 = class(TDataModule)
    ConexaoDB: TFDConnection;
    procedure DataModuleCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  DataModule1: TDataModule1;

implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}


uses System.IniFiles, System.IOUtils;


{$R *.dfm}

procedure TDataModule1.DataModuleCreate(Sender: TObject);
var
  Ini: TIniFile;
begin
  Ini := TIniFile.Create(TPath.Combine(ExtractFilePath(ParamStr(0)), 'config.ini'));
  try
    ConexaoDB.Params.Values['Server'] := Ini.ReadString('DB','Server','');
    ConexaoDB.Params.Values['Database'] := Ini.ReadString('DB','Database','');
    ConexaoDB.Params.Values['User_Name'] := Ini.ReadString('DB','User','');
    ConexaoDB.Params.Values['Password'] := Ini.ReadString('DB','Password','');

    ConexaoDB.LoginPrompt := False;
    ConexaoDB.Connected := True;
  finally
    Ini.Free;
  end;
end;

end.
