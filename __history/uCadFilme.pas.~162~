procedure TfrmCadFilme.mskEditChange(Sender: TObject);
var Date:TDateTime;
begin

  if(trim(TMaskEdit(Sender).Text) = '')then
    Exit;

  if(QryCatalogo.FieldByName(IndiceAtual).DataType in [ftString, ftWideString] )then
  begin
    QryCatalogo.Locate(IndiceAtual, TMaskEdit(Sender).Text, [loPartialKey])
  end

  else if(QryCatalogo.FieldByName(IndiceAtual).DataType in [ftFloat, ftCurrency, ftFMTBcd] )then
  begin
   try
     QryCatalogo.Locate(IndiceAtual, (TMaskEdit(Sender).Text), [])
   except

   end;
  end

  else if(QryCatalogo.FieldByName(IndiceAtual).DataType in [ftDate, ftDateTime, ftTimeStamp] )then
  begin
   if TryStrToDate(TMaskEdit(Sender).Text, Date) then
   begin
     QryCatalogo.Locate(IndiceAtual, Date, []);
   end
  end
  else
     QryCatalogo.Locate(IndiceAtual, TMaskEdit(Sender).Text, [])
end;

