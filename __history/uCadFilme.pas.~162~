procedure TfrmCadFilme.btnPesquisarClick(Sender: TObject);
var I:Integer;
    TipoCampo:TFieldType;
    NomeCampo: string;
    WhereOrAnd: string;
    CondicaoSQL: string;
begin

  if mskEdit.Text='' then
  begin
    QryCatalogo.Close;
    QryCatalogo.SQL.Clear;
    QryCatalogo.SQL.Add(SelectOriginal);
    QryCatalogo.Open;
    Abort;
  end;

  for I := 0 to QryCatalogo.FieldCount-1 do
  begin
    if QryCatalogo.Fields[i].FieldName=IndiceAtual then
    begin
      TipoCampo := QryCatalogo.Fields[i].DataType;
      if QryCatalogo.Fields[i].Origin<>'' then
      begin
        if Pos('.',QryCatalogo.Fields[i].Origin) > 1 then
        NomeCampo := QryCatalogo.Fields[i].Origin
        else
        NomeCampo := QryCatalogo.Fields[i].Origin+'.'+QryCatalogo.Fields[i].FieldName
      end
      else
      NomeCampo := QryCatalogo.Fields[i].FieldName;
      Break;
    end;
  end;

  if Pos('where', LowerCase(SelectOriginal)) > 0 then
  begin
    WhereOrAnd := ' and '
  end
  else
  begin
    WhereOrAnd := ' where ';
  end;

  if (TipoCampo=ftString) or (TipoCampo=ftWideString) then
  begin
    CondicaoSQL := WhereOrAnd+' '+ NomeCampo + ' LIKE '+QuotedStr('%'+mskEdit.Text+'%');
  end
  else if (TipoCampo in [ftInteger, ftSmallint, ftAutoInc]) then
  begin
    CondicaoSQL := WhereOrAnd+''+NomeCampo + '='+mskEdit.Text
  end


  else if (TipoCampo in [ftDate, ftDateTime, ftdate, ftTimeStamp]) then
  begin
      CondicaoSQL := WhereOrAnd+' '+' CAST '+'('+NomeCampo +' as date)' + '='+QuotedStr(mskEdit.Text)
  end


 else if (TipoCampo in [ftFloat, ftCurrency, ftFMTBcd]) then
 begin
    CondicaoSQl := WhereOrAnd+''+NomeCampo + '='+StringReplace(mskEdit.Text,',','.',[rfReplaceAll]);
 end;


  QryCatalogo.Close;
  QryCatalogo.SQL.Clear;
  QryCatalogo.SQL.Add(SelectOriginal);
  QryCatalogo.SQL.Add(CondicaoSQL);
  QryCatalogo.Open;

  mskEdit.Text:='';
  mskEdit.SetFocus;

end;

function TfrmCadFilme.Excluir: Boolean;
begin
  if oFilme.Seleciona(QryCatalogo.FieldByName('idFilme').AsInteger) then begin
    result:=oFilme.Apagar;
  end;
end;

function TfrmCadFilme.Gravar(EstadoDoCadastro: TEstadoDoCadastro): Boolean;
begin
  if edtIdFilme.Text<>EmptyStr then
     oFilme.idFilme:=StrToInt(edtIdFilme.Text)
  else
     oFilme.idFilme:=0;

  oFilme.titulo                  :=edtTitulo.Text;
  oFilme.diretor                 :=edtDiretor.Text;
  oFilme.genero                  :=edtGenero.Text;
  oFilme.sinopse                 :=edtSinopse.Text;
  oFilme.anoLancamento           :=edtLancamento.Text;

 if (EstadoDoCadastro = ecInserir) then
  begin
    Result := oFilme.Gravar;
  end
  else if (EstadoDoCadastro = ecAlterar) then
  begin
    Result := oFilme.Atualizar;
  end;

limparComponenteitem;
end;


{$REGION 'GRID'}
procedure TfrmCadFilme.grdFilmesDrawColumnCell(Sender: TObject; const Rect: TRect; DataCol: Integer; Column: TColumn;
  State: TGridDrawState);
var
  Linha: Integer;
begin
  if (gdFixed in State) then
  begin
    grdFilmes.Canvas.Brush.Color := clGray;
    grdFilmes.Canvas.FillRect(Rect);
    Exit;
  end;

  Linha := grdFilmes.DataSource.DataSet.RecNo;

  if gdSelected in State then
  begin
    grdFilmes.Canvas.Brush.Color := $00D8A76F;
    grdFilmes.Canvas.Font.Color := clwhite;
  end
  else
  begin
    if (Linha mod 2) = 0 then
      grdFilmes.Canvas.Brush.Color := clWebLightgrey
    else
      grdFilmes.Canvas.Brush.Color := $00FFFFFF;

    grdFilmes.Canvas.Font.Color := clBlack;
  end;

  grdFilmes.Canvas.FillRect(Rect);

  grdFilmes.DefaultDrawColumnCell(Rect, DataCol, Column, State);
end;

