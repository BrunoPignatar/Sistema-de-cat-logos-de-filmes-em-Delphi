function TfrmCadFilme.RetornarCampoTraduzido(Campo:String):String;
  var i:Integer;
  begin
      for I := 0 to QryCatalogo.Fields.Count-1 do begin
        if LowerCase(QryCatalogo.Fields[i].FieldName)=LowerCase(Campo)then begin
          Result:= QryCatalogo.Fields[i].DisplayLabel;
          Break;
        end;
      end;
  end;




procedure TfrmCadFilme.ExportarCSV(ADataset: TDataSet);
var
  Lista: TStringList;
begin
  Lista := TStringList.Create;
  try
    Lista.Add('CodFilme;Titulo;Diretor;Genero;AnoLancamento;Sinopse');

    ADataset.First;
    while not ADataset.Eof do
    begin
      Lista.Add(
        ADataset.FieldByName('idFilme').AsString + ';' +
        ADataset.FieldByName('titulo').AsString + ';' +
        ADataset.FieldByName('diretor').AsString + ';' +
        ADataset.FieldByName('genero').AsString + ';' +
        ADataset.FieldByName('anoLancamento').AsString + ';' +
        ADataset.FieldByName('sinopse').AsString);


      ADataset.Next;
    end;
     try
      SaveDialog1.FileName := 'CatalogoFilmes.csv';
      SaveDialog1.DefaultExt := 'csv';
      SaveDialog1.Filter := 'Arquivo CSV (*.csv)|*.csv';

      if SaveDialog1.Execute then
      begin
         TFile.WriteAllText(
         SaveDialog1.FileName,
         Lista.Text,
         TEncoding.UTF8
                        );
      end;
    except
      on E: EFCreateError do
        ShowMessage('Para exportar CSV é preciso fechar o arquivo já aberto.');
      on E: Exception do
        ShowMessage('Erro ao exportar CSV: ' + E.Message);
    end;
  finally
    Lista.Free;
  end;
end;


