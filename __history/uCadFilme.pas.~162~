procedure TfrmCadFilme.btnGravarClick(Sender: TObject);
begin
  CamposObrigatorios;
  if edtIdFilme.Text <> '' then
    oFilme.idFilme := StrToInt(edtIdFilme.Text)
  else
    oFilme.idFilme := 0;

  oFilme.titulo := edtTitulo.Text;
  oFilme.diretor := edtDiretor.Text;
  oFilme.genero := edtGenero.Text;
  oFilme.sinopse := edtSinopse.Text;
  oFilme.anoLancamento := edtLancamento.Text;

  if FEstadoDoCadastro = ecInserir then
    oFilme.Gravar
  else if FEstadoDoCadastro = ecAlterar then
    oFilme.Atualizar;

  QryCatalogo.Close;
  QryCatalogo.Open;

  ControlarIndiceTab(PageControl1, 0);
end;

procedure TfrmCadFilme.btnImportarClick(Sender: TObject);
var
  gravar, ler: TStringList;
  i, Inseridos: Integer;
  Linha: string;
  Extensao: string;
begin
  gravar := TStringList.Create;
  ler := TStringList.Create;
  Inseridos := 0;

  try
    if not OpenDialog1.Execute then
      Exit;

    Extensao := LowerCase(ExtractFileExt(OpenDialog1.FileName));

    if Extensao <> '.txt' then
    begin
      ShowMessage('Arquivo inválido. Esperado: .txt');
      Exit;
    end;

    ler.LoadFromFile(OpenDialog1.FileName, TEncoding.UTF8);

    gravar.Delimiter := '|';
    gravar.StrictDelimiter := True;

    for i := 0 to Pred(ler.Count) do
    begin
      Linha := Trim(ler[i]);

      if Linha = '' then
        Continue;

      if Pos('|', Linha) = 0 then
      begin
        ShowMessage('Formato inválido! Use "|" como separador.');
        Exit;
      end;

      gravar.DelimitedText := Linha;

      if (gravar.Count < 5) or (gravar.Count > 5)then
      begin
        ShowMessage('Arquivo com estrutura inválida. Verifique as colunas.');
        Exit;
      end;

      if ExisteFilme(Trim(gravar[0]), Trim(gravar[1])) then
        Continue;

      QryCatalogo.Append;
      try
        QryCatalogo.FieldByName('titulo').AsString := Trim(gravar[0]);
        QryCatalogo.FieldByName('diretor').AsString := Trim(gravar[1]);
        QryCatalogo.FieldByName('genero').AsString := Trim(gravar[2]);
        QryCatalogo.FieldByName('sinopse').AsString := Trim(gravar[3]);
        QryCatalogo.FieldByName('anoLancamento').AsString := Trim(gravar[4]);
        QryCatalogo.Post;

        Inc(Inseridos);
      except
        QryCatalogo.Cancel;
        raise;
      end;
    end;

    QryCatalogo.Close;
    QryCatalogo.Open;

    if Inseridos > 0 then
      ShowMessage('Importação realizada com sucesso!')
    else
      ShowMessage('Nenhum registro importado (duplicados ou arquivo vazio).');

  finally
    gravar.Free;
    ler.Free;
  end;
end;

function TfrmCadFilme.ExisteFilme(const ATitulo, ADiretor: string): Boolean;
begin
  with QryVerifica do
  begin
    Close;
    SQL.Text :=
      'SELECT 1 FROM catalogo ' +
      'WHERE RTRIM(LTRIM(titulo)) = RTRIM(LTRIM(:titulo)) ' +
      'AND RTRIM(LTRIM(diretor)) = RTRIM(LTRIM(:diretor))';

    ParamByName('titulo').AsString := Trim(ATitulo);
    ParamByName('diretor').AsString := Trim(ADiretor);
    Open;

    Result := not IsEmpty;
  end;
end;


