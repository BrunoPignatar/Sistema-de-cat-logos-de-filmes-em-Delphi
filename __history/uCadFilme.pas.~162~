procedure TfrmCadFilme.btnAlterarClick(Sender: TObject);
begin
   ControlarIndiceTab(PageControl1,1);
  FEstadoDoCadastro:= ecAlterar;
  if oFilme.Seleciona(QryCatalogo.FieldByName('idFilme').AsInteger) then begin
     edtIdFilme.Text:=IntToStr(oFilme.idFilme);
     edtTitulo.Text:=oFilme.titulo;
     edtDiretor.Text:=oFilme.diretor;
     edtGenero.Text:=oFilme.genero;
     edtSinopse.Text:=oFilme.sinopse;
     edtLancamento.Text:=oFilme.anoLancamento;
  end
  else begin
    btnCancelar.Click;
    Abort;
  end;

end;

procedure TfrmCadFilme.btnApagarClick(Sender: TObject);
begin
   try
